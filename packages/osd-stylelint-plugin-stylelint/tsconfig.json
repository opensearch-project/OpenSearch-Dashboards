{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "declarationDir": "./target",
    "outDir": "./target",
    "stripInternal": true,
    "declarationMap": true,
    "types": ["jest", "node"],
    "noImplicitAny": false,
    "baseUrl": ".",
    "paths": {
      // see types/postcss.d.ts
      "postcss": ["./types/postcss.d.ts"]
    }
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["target"]
}
